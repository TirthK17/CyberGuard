# ==============================================================================
# CyberGuard (Kavach) Environment Variables
# Production Supabase Configuration
# ==============================================================================
# Note: ONLY public variables prefixed with VITE_ are exposed to the browser client.
# NEVER include your Supabase service_role secret key here.

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon (Public) Key (From Supabase Dashboard -> Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
